# =================================================================
# GramBandhan Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local environment
# =================================================================

# Server & Runtime
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grambandhan?schema=public"

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-secure-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Caching & BullMQ Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 / Cloud Object Storage (Documents, KYC, Harvest Proofs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev-access-key
AWS_SECRET_ACCESS_KEY=dev-secret-key
AWS_S3_BUCKET_NAME=grambandhan-uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:5500

# Swagger Interactive API Documentation
SWAGGER_ENABLED=true

# Notification & Transactional Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GramBandhan <noreply@grambandhan.com>"

# Blockchain Integration (Base Sepolia Testnet)
BLOCKCHAIN_CHAIN_ID=84532
BLOCKCHAIN_RPC_URL=https://sepolia.base.org
BLOCKCHAIN_PRIVATE_KEY=your-private-key-without-0x-or-with-0x
AGRI_PLATFORM_ADDRESS=0x9048648B1109Ea88d24016e7DAf6e5032316d29F
