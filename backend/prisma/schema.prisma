  attester         User     @relation("OracleAttester", fields: [attesterId], references: [id], onDelete: Restrict)
  verifiedByUser   User?    @relation("OracleVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  harvests         Harvest[]

  @@index([entityType, entityId])
  @@index([attesterId])
  @@index([dataHash])
  @@index([verified])
  @@map("oracle_attestations")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
