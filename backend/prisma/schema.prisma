model FieldAgentProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  assignedRegion     String
  nationalId         String?
  rating             Decimal            @default(0.0) @db.Decimal(3, 2)
  isVerified         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation("FieldAgentUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedMilestones ProjectMilestone[] @relation("MilestoneVerifiedByAgent")

  @@index([userId])
  @@index([assignedRegion])
  @@map("field_agent_profiles")
}

model ProductListing {
  id            String          @id @default(uuid()) @db.Uuid
  producerId    String          @db.Uuid
  name          String          @db.VarChar(150)
  category      String?         @db.VarChar(100)
  price         Decimal         @db.Decimal(12, 2)
  quantity      Int             @default(0)
  unit          String          @default("kg") @db.VarChar(30)
  description   String?
  deliveryArea  String?         @db.VarChar(150)
  imageUrl      String?
  isAvailable   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  producer      User            @relation(fields: [producerId], references: [id], onDelete: Cascade)
  orders        Order[]
  ratings       Rating[]

  @@index([producerId])
  @@index([category])
  @@map("product_listings")
}

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  buyerId         String         @db.Uuid
  listingId       String         @db.Uuid
  quantity        Int
  totalPrice      Decimal        @db.Decimal(12, 2)
  status          OrderStatus    @default(PLACED)
  paymentMethod   PaymentMethod?
  deliveryAddress String?
  orderedAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  buyer           User           @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  listing         ProductListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
  @@map("orders")
}

model InsurancePolicy {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  provider       String              @db.VarChar(150)
  coverageType   String              @db.VarChar(100)
  coverageAmount Decimal             @db.Decimal(14, 2)
  premiumAmount  Decimal             @db.Decimal(12, 2)
  status         InsuranceStatus     @default(ACTIVE)
  startedAt      DateTime            @default(now())
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project        AgriculturalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  claims         InsuranceClaim[]

  @@index([projectId])
  @@index([status])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id               String          @id @default(uuid()) @db.Uuid
  policyId         String          @db.Uuid
  reason           String
  damageAssessment String?
  claimAmount      Decimal         @db.Decimal(14, 2)
  approvedAmount   Decimal?        @db.Decimal(14, 2)
  evidenceUrls     String[]        @default([])
  status           ClaimStatus     @default(SUBMITTED)
  filedAt          DateTime        @default(now())
  settledAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  policy           InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([status])
  @@map("insurance_claims")
}

model RiskScore {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  score          Decimal             @db.Decimal(5, 2)
  level          RiskLevel
  factors        String?
  recommendation String?
  generatedAt    DateTime            @default(now())

  project        AgriculturalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([level])
  @@map("risk_scores")
}

model FraudAlert {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String?         @db.Uuid
  transactionId  String?         @db.Uuid
  reason         String
  severity       AlertSeverity   @default(MEDIUM)
  isResolved     Boolean         @default(false)
  flaggedAt      DateTime        @default(now())
  resolvedAt     DateTime?

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  transaction    Payment?        @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isResolved])
  @@map("fraud_alerts")
}

model Rating {
  id          String               @id @default(uuid()) @db.Uuid
  fromUserId  String               @db.Uuid
  toUserId    String?              @db.Uuid
  projectId   String?              @db.Uuid
  listingId   String?              @db.Uuid
  stars       Int                  @db.SmallInt
  comment     String?
  createdAt   DateTime             @default(now())

  author      User                 @relation("RatingAuthor", fields: [fromUserId], references: [id], onDelete: Cascade)
  recipient   User?                @relation("RatingRecipient", fields: [toUserId], references: [id], onDelete: SetNull)
  project     AgriculturalProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  listing     ProductListing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([projectId])
  @@index([listingId])
  @@map("ratings")
}